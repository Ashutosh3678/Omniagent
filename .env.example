# Copy to .env and edit. .env is gitignored.

# Backend
OMNIAGENT_APP_TOKEN=dev-app-token
OMNIAGENT_AGENT_TOKEN=dev-agent-token
OMNIAGENT_TASK_TIMEOUT=90
OMNIAGENT_HOST=0.0.0.0
OMNIAGENT_PORT=8000

# Desktop agent
OMNIAGENT_API=http://127.0.0.1:8000
OMNIAGENT_PC_NAME=Office PC

# Mobile is configured at run time:
#   flutter run --dart-define=API_BASE=http://10.0.2.2:8000 --dart-define=APP_TOKEN=dev-app-token
